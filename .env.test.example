# Test environment variables
# Copy this to .env.test and update with your test credentials

# Base URL (default: http://localhost:3004)
BASE_URL=http://localhost:3004

# Supabase Test Project (optional - use separate project for testing)
# NEXT_PUBLIC_SUPABASE_URL=your-test-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Google Gemini API (use same as dev or separate test key)
# GOOGLE_GEMINI_API_KEY=your-test-api-key
